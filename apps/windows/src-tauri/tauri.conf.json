{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LockGuard",
  "version": "0.0.1",
  "identifier": "com.lockguard.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [{
      "title": "LockGuard",
      "width": 1200,
      "height": 800,
      "minWidth": 900,
      "minHeight": 640,
      "resizable": true,
      "fullscreen": false,
      "center": true
    }],
    "security": {"csp": null}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LockGuard",
    "copyright": "LockGuard",
    "category": "Utility",
    "shortDescription": "Secure Password Manager",
    "longDescription": "LockGuard password manager with encrypted vault synchronization.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}